{
  "name": "codesmith",
  "version": "0.1.0",
  "private": true,
  "description": "A local TypeScript coding agent for software projects",
  "type": "module",
  "bin": {
    "codesmith": "./dist/src/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/core/agent-core.d.ts",
      "default": "./dist/src/core/agent-core.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" && prettier --check .",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky",
    "start": "npm run build && node dist/src/cli/main.js",
    "test": "npm run build && cd dist && node --test"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "onnxruntime-web": "^1.27.0"
  }
}
